{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vault",
  "version": "1.4.0",
  "identifier": "com.local.vault",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "密码库",
        "width": 1240,
        "height": 800,
        "minWidth": 1020,
        "minHeight": 620,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "category": "Utility",
    "shortDescription": "本地离线加密密码库",
    "longDescription": "所有数据以 AES-256-GCM 加密后保存在本机，不联网、不上传、不需要账号。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "nsis": {
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
