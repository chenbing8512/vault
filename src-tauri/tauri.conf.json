{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vault",
  "version": "1.7.4",
  "identifier": "com.local.vault",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "密码库",
        "width": 1240,
        "height": 800,
        "minWidth": 1020,
        "minHeight": 620,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis"
    ],
    "category": "Utility",
    "shortDescription": "本地离线加密密码库",
    "longDescription": "本地加密密码库，可选多设备同步（零知识，服务端只存密文）。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "nsis": {
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": false
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk0NTBDQzg1RUFCNDZEQjgKUldTNGJiVHFoY3hRbE1DVVEwZngxeGtsbldYUDRFTFhvbVc2WVoxR0dNRVdWV1d1V2dYVmt2MWUK",
      "endpoints": [
        "https://github.com/chenbing8512/vault/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
